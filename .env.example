# Justina — environment template.
# Copy to .env and fill in. NEVER commit .env; it holds live credentials.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (SQL Server, in Docker)
# ---------------------------------------------------------------------------
# Must satisfy the SQL Server password policy: 8+ characters with upper, lower,
# digit and symbol. The container refuses to start otherwise.
MSSQL_SA_PASSWORD=

# ---------------------------------------------------------------------------
# Tool API
# ---------------------------------------------------------------------------
# Shared between justina-openclaw and justina-app over the Docker network.
# Generate a long random value, e.g.:  openssl rand -hex 32
JUSTINA_TOOL_SECRET=

# ---------------------------------------------------------------------------
# OpenAI (external — Vision / document reading)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp Business / Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
# Echoed back during webhook subscription setup.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# ngrok (public ingress for webhooks)
# ---------------------------------------------------------------------------
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------
# External business APIs
# ---------------------------------------------------------------------------
# The Expense integration has three independent seams — the category/tax
# catalogue, tenant resolution, and submission — and each picks a mock or a real
# implementation from configuration alone. Nothing in the application layer
# changes; flipping a seam is a restart, not a code change.
#
#   ExpenseApi__Mode=Stub    all three served from mock data (the default)
#   ExpenseApi__Mode=Live    all three against the Expense API
#
# Per-seam overrides win over Mode, so a seam can go live on its own. Reading a
# category list needs far less than filing an expense does, so that is the order
# these will actually go live in:
#
#   ExpenseApi__CatalogueMode=Live
#   ExpenseApi__TenantMode=Stub
#   ExpenseApi__SubmissionMode=Stub
#
# Startup refuses rather than misleading anyone: any seam left on Stub under
# ASPNETCORE_ENVIRONMENT=Production is a startup error, and so is a Live seam
# with no BaseUrl.
EXPENSE_API_MODE=Stub

# Required once any seam is Live. Dev is https://apis.justlogindevelopment.xyz
# (staging: apis.justloginstaging.xyz, production: apis.justlogin.com).
EXPENSE_API_URL=

# Bearer token sent with catalogue and submission calls. The catalogue routes
# take the organization in the path, so a system token is sufficient — no
# company-scoped token has to be minted per conversation.
EXPENSE_API_KEY=

# Required when TenantMode=Live. Nothing in expense-api maps a phone number or
# an email to a member (plan risk R12), so a live deployment serves one
# configured company until that lookup exists.
EXPENSE_ORGANIZATION_ID=
EXPENSE_MEMBER_ID=

# Recruitment is routing-only in phase 1; leaving this blank is expected.
RECRUITMENT_API_URL=
RECRUITMENT_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Set to an OTLP collector endpoint to export traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# First access
# ---------------------------------------------------------------------------
# Justina refuses everything for a user it has no record of. This grants the
# first principals their capabilities. JSON array, applied idempotently at
# startup. Channel is "telegram" or "whatsapp"; userId is the channel's own
# numeric user id.
#   JUSTINA_SEED_PRINCIPALS=[{"channel":"telegram","userId":"12345","displayName":"Your Name","capabilities":["expense.submit","expense.read","recruitment.search"]}]
JUSTINA_SEED_PRINCIPALS=

# ---------------------------------------------------------------------------
# OpenClaw gateway
# ---------------------------------------------------------------------------
# The gateway binds all interfaces inside the container (loopback would be
# unreachable from other services), and a non-loopback bind makes auth
# mandatory. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Claude (optional alternative LLM for the gateway)
# ---------------------------------------------------------------------------
# The gateway runs on OpenAI by default, reusing OPENAI_API_KEY above —
# one credential for both the agent and document Vision.
#
# To run the agent on Claude instead: set this key, add an anthropic
# provider block to docker/openclaw/openclaw.json, pass ANTHROPIC_API_KEY
# into the justina-openclaw service, and set the model ref to
# anthropic/claude-opus-5.
# Two routes:
#   1. An Anthropic API key from console.anthropic.com (sk-ant-api...).
#      Pay-as-you-go; recommended for shared automation.
#   2. A Claude subscription setup-token: run `claude setup-token` on a machine
#      with Claude Code installed, then inside the container:
#        openclaw models auth login --provider anthropic --method setup-token
#      That stores it in the gateway auth profile instead of this variable.
ANTHROPIC_API_KEY=
