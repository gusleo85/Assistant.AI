# Justina — environment template.
# Copy to .env and fill in. NEVER commit .env; it holds live credentials.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (SQL Server, in Docker)
# ---------------------------------------------------------------------------
# Must satisfy the SQL Server password policy: 8+ characters with upper, lower,
# digit and symbol. The container refuses to start otherwise.
MSSQL_SA_PASSWORD=

# ---------------------------------------------------------------------------
# Tool API
# ---------------------------------------------------------------------------
# Shared between justina-openclaw and justina-app over the Docker network.
# Generate a long random value, e.g.:  openssl rand -hex 32
JUSTINA_TOOL_SECRET=

# ---------------------------------------------------------------------------
# OpenAI (external — Vision / document reading)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp Business / Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
# Echoed back during webhook subscription setup.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# ngrok (public ingress for webhooks)
# ---------------------------------------------------------------------------
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------
# External business APIs
# ---------------------------------------------------------------------------
# NOTE: the Expense API contract has not been supplied yet (plan risk R1).
# Until it is, justina-app runs against a provisional contract and submission
# is exercised with a stub in the integration tests.
EXPENSE_API_URL=
EXPENSE_API_KEY=

# Recruitment is routing-only in phase 1; leaving this blank is expected.
RECRUITMENT_API_URL=
RECRUITMENT_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Set to an OTLP collector endpoint to export traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# First access
# ---------------------------------------------------------------------------
# Justina refuses everything for a user it has no record of. This grants the
# first principals their capabilities. JSON array, applied idempotently at
# startup. Channel is "telegram" or "whatsapp"; userId is the channel's own
# numeric user id.
#   JUSTINA_SEED_PRINCIPALS=[{"channel":"telegram","userId":"12345","displayName":"Your Name","capabilities":["expense.submit","expense.read","recruitment.search"]}]
JUSTINA_SEED_PRINCIPALS=
