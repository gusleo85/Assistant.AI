<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      JustLogin's private feed, carrying JustLogin.SDK.Core and the Justlogin.Configurations packages
      the vendored Identity SDK builds against. The path segment after /auth/ is an access token, so
      this URL is a credential in its own right — it is committed here because the same URL is already
      committed in ReceiptScannerLambda, ReimbursementEventIntegrationLambda and
      JustLogin.NotificationPDFGenerator.Lambda, and splitting it out here would protect nothing while
      breaking the Docker build. If it is ever rotated, it must be rotated in all four.
    -->
    <add key="nuget.jl" value="https://www.myget.org/F/justlogin/auth/34376c58-48b4-4960-ba32-1fcfff4d2b3b/api/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <disabledPackageSources />
</configuration>
