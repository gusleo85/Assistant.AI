root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces always — a single-statement if without braces is where bugs hide during edits
csharp_prefer_braces = true:warning

# Prefer explicit types except where the right-hand side already says it
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# the codebase already uses
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# Immutability by default
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning

# Analyzer rules we care about
dotnet_diagnostic.CA2007.severity = none          # ConfigureAwait is applied in library code by convention
dotnet_diagnostic.CA1848.severity = none          # LoggerMessage source generators are overkill here
dotnet_diagnostic.CA1416.severity = error         # platform compatibility — suppressed only where justified

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh}]
end_of_line = lf
