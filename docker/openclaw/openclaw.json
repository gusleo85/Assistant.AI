{
  // Justina's OpenClaw gateway configuration. JSON5: comments and trailing commas are legal.
  //
  // Seeded into the gateway's state volume on first start (see justina-openclaw-init in
  // docker-compose.yml). It is NOT mounted read-only, because the gateway rewrites this file
  // atomically and the docs warn that symlinked or read-only config layouts break those writes.
  //
  // ${VAR} substitution is uppercase-only and is filled from the container environment, so no secret
  // is ever written into this file.
  //
  // Validation is strict: an unknown key makes the gateway refuse to start. Do not invent keys.

  gateway: {
    // The gateway refuses to start unless this is "local"; "remote" means "be a client of another
    // gateway", which is not what we are running here.
    mode: "local",
    port: 18789,

    // The default "loopback" bind listens on 127.0.0.1 *inside* the container, which is unreachable
    // from other services on the Docker network. "lan" binds all interfaces.
    bind: "lan",

    // A non-loopback bind makes gateway auth mandatory.
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },

    // Would otherwise expose an admin host shell inside the container on demand.
    terminal: { enabled: false },
  },

  // OpenAI is the LLM, sharing the single OPENAI_API_KEY that justina-app already uses for document
  // Vision. One credential, one bill, one thing to rotate.
  //
  // To run the agent on Claude instead, add an anthropic provider block with
  //   anthropic: { apiKey: "${ANTHROPIC_API_KEY}" }
  // pass ANTHROPIC_API_KEY into this container, and set the model ref below to anthropic/claude-opus-5.
  // The two are independent: the gateway's reasoning model and the Vision provider need not match.
  models: {
    mode: "merge",
    providers: {
      openai: {
        apiKey: "${OPENAI_API_KEY}",
      },
    },
  },

  // The only supported route from an OpenClaw agent to an external tool is an MCP server — there is no
  // configuration for calling a plain HTTP JSON API. justina-app serves MCP at /mcp for exactly this.
  mcp: {
    servers: {
      justina: {
        url: "http://justina-app:8080/mcp",
        transport: "streamable-http",
        headers: {
          "X-Justina-Tool-Key": "${JUSTINA_TOOL_SECRET}",
        },
        requestTimeoutMs: 120000,
        connectionTimeoutMs: 10000,
      },
    },
  },

  // "messaging" implicitly allows bundle-mcp (the Justina tools) without turning on Code Mode, which
  // the reasoning model does not support and which the gateway warns degrades performance.
  tools: {
    profile: "messaging",

    // The bundled codex runtime turns Code Mode on by default, but gpt-5.4 does not advertise support
    // for it and the gateway warns that it degrades performance. Justina calls eight typed tools; it
    // never writes or runs code, so there is nothing here for Code Mode to do.
    codeMode: false,
  },

  agents: {
    defaults: {
      // Persona and behaviour come from the bootstrap files in this workspace (AGENTS.md), because
      // OpenClaw has no per-agent systemPrompt key.
      workspace: "/config/workspace",
      contextInjection: "always",
      model: {
        primary: "openai/gpt-5.4",
        fallbacks: [],
      },

      // Direct OpenAI API traffic rather than the bundled Codex harness. Codex auto-enables Code Mode,
      // which gpt-5.4 does not advertise support for — the gateway warns on every turn that it degrades
      // performance. Justina is not a coding agent: it holds a conversation and calls eight typed tools,
      // so the harness brings cost and no benefit.
      models: {
        "openai/gpt-5.4": {
          agentRuntime: { id: "openclaw" },
        },
      },
    },
    entries: {
      justina: {
        name: "Justina",
        identity: { name: "Justina" },
      },
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",

      // Long polling is the default transport, so no public URL and no tunnel are required for
      // Telegram. Only outbound HTTPS to api.telegram.org is needed.
      //
      // "pairing" means an unknown sender gets a one-time code that an approver must accept, rather
      // than being served straight away. It is the safe default while the allowlist is empty — an
      // "allowlist" policy with no entries is rejected by config validation anyway.
      dmPolicy: "pairing",

      // Written by the gateway when a pairing code was approved. Kept here so reseeding the config
      // volume does not silently revoke an approved sender.
      allowFrom: ["646882196"],

      // Groups stay closed until a chat is listed explicitly.
      groupPolicy: "allowlist",
    },
  },

  commands: {
    // Owner-only commands. Set by the gateway on first pairing approval.
    ownerAllowFrom: ["telegram:646882196"],
  },

  logging: {
    level: "info",
    consoleStyle: "json",
  },
}
