{
  "$comment": [
    "Justina's OpenClaw gateway configuration.",
    "Copy to the gateway config volume as openclaw.json and fill in from environment variables.",
    "Secrets are referenced as ${VAR} and supplied by docker-compose from .env — never inline them here.",
    "",
    "VERIFY BEFORE FIRST RUN (plan risk R3): the exact key names for tool/skill registration depend on the",
    "OpenClaw version pinned in OPENCLAW_IMAGE. The Justina side is stable regardless — it is an HTTP JSON",
    "API — so only this file changes if the gateway expects a different shape."
  ],

  "gateway": {
    "bind": "0.0.0.0",
    "port": 18789
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": []
    },
    "whatsapp": {
      "enabled": true,
      "accessToken": "${WHATSAPP_ACCESS_TOKEN}",
      "phoneNumberId": "${WHATSAPP_PHONE_NUMBER_ID}",
      "appSecret": "${WHATSAPP_APP_SECRET}",
      "webhookVerifyToken": "${WHATSAPP_WEBHOOK_VERIFY_TOKEN}",
      "allowFrom": []
    }
  },

  "providers": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}"
    }
  },

  "tools": {
    "justina": {
      "type": "http",
      "baseUrl": "${JUSTINA_TOOL_BASE_URL}",
      "headers": {
        "X-Justina-Tool-Key": "${JUSTINA_TOOL_SECRET}"
      },
      "definitions": "/seed/tools/justina-tools.json"
    }
  },

  "agents": {
    "orchestrator": {
      "promptFile": "/seed/agents/orchestrator.md",
      "default": true
    },
    "intent-router": {
      "promptFile": "/seed/agents/intent-router.md"
    },
    "expense-agent": {
      "promptFile": "/seed/agents/expense-agent.md"
    },
    "recruitment-agent": {
      "promptFile": "/seed/agents/recruitment-agent.md"
    }
  }
}
