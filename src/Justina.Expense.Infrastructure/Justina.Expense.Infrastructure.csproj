<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Justina.Expense.Application\Justina.Expense.Application.csproj" />
    <ProjectReference Include="..\Justina.Core.Infrastructure\Justina.Core.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock member and channel-link data for ExpenseApi:Mode=Stub. Embedded so it travels with the
