<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Justina.Expense.Application\Justina.Expense.Application.csproj" />
    <ProjectReference Include="..\Justina.Core.Infrastructure\Justina.Core.Infrastructure.csproj" />
    <!-- Vendored JustLogin identity client. Referenced here and nowhere else: an architecture test
         holds that line, so no SDK type can reach a handler. -->
    <ProjectReference Include="..\JustLogin.Identity.SDK\JustLogin.Identity.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock member and channel-link data for ExpenseApi:Mode=Stub. Embedded so it travels with the
         container image; no volume mount and no config path to get wrong. -->
    <EmbeddedResource Include="MockData\members.json" />
    <EmbeddedResource Include="MockData\channel-links.json" />
    <EmbeddedResource Include="MockData\categories.json" />
    <EmbeddedResource Include="MockData\taxes.json" />
    <EmbeddedResource Include="MockData\currencies.json" />
    <EmbeddedResource Include="MockData\organization.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
